---
import { loadProfile } from '../content/profile';

const profile = loadProfile();
const currentYear = new Date().getFullYear();
---
<footer class="footer">
  <div class="footer__row">
    <span>© {currentYear} {profile.name}  ·  no cookies  ·  no tracking</span>
    <span class="footer__spacer"></span>
    <button type="button" class="footer__help dim" data-help-open>press <kbd>?</kbd> for shortcuts</button>
  </div>
</footer>

---
import { loadProfile } from '../content/profile';
import { SECTIONS } from '../content/sections';

interface Props {
  currentSectionId?: string;
}

const { currentSectionId = 'about' } = Astro.props;
const profile = loadProfile();
---
<header class="header">
  <div class="header__row">
    <span class="header__path"><span class="dim">~/</span>{profile.handle}<span class="dim"> · </span><span data-current-section>{currentSectionId}</span></span>
    <nav class="header__nav" aria-label="sections">
      {SECTIONS.map((s) => (
        <a class="navlink" href={`#${s.id}`}><span class="dim">[{s.key}]</span> {s.label}</a>
      ))}
    </nav>
    <div class="header__meta">
      <button
        type="button"
        class="iconbtn header__navtoggle"
        data-nav-toggle
        aria-label="toggle navigation"
        aria-expanded="false"
        aria-controls="header-nav-panel"
      >[nav]</button>
      <button type="button" class="iconbtn" data-theme-toggle aria-label="toggle theme">[t]</button>
    </div>
  </div>
  <nav
    id="header-nav-panel"
    class="header__panel"
    aria-label="sections"
    data-nav-panel
    hidden
  >
    {SECTIONS.map((s) => (
      <a class="navlink" href={`#${s.id}`}><span class="dim">[{s.key}]</span> {s.label}</a>
    ))}
  </nav>
</header>
<script>
  import '../scripts/nav-toggle';
</script>
